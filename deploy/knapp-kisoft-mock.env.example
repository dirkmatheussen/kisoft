# Copy to /etc/knapp-kisoft-mock/env and restrict permissions: chmod 600
# Read by both the Java service and the .NET service.
MOCK_UI_PASSWORD=not1nvented!

# Optional JVM tuning (Java service only)
# JAVA_OPTS=-Xms256m -Xmx1g

# Optional JSON overrides. Wins over the variables below; --knapp.mock.* wins over this.
# SPRING_APPLICATION_JSON={"knapp":{"mock":{"inbound-auto-stock":true}}}

# Database file. Java stores H2 at this path; .NET stores SQLite at the same path plus .db.
# KNAPP_H2_FILE=/opt/knapp-kisoft-mock/data/kisoftmock

# Listen port (default 8084). Context path stays /kisoft unless overridden.
# SERVER_PORT=8084
# SERVER_SERVLET_CONTEXT_PATH=/kisoft

# Outgoing KiSoft → HOST webhooks (IBM APIC + Entra ID). Leave the URL blank to disable callbacks.
# KNAPP_REPLY_CALLBACK_URL=https://api-test.example/vgcd/external/host/kisoft
# KNAPP_WEBHOOK_IBM_CLIENT_ID=
# KNAPP_WEBHOOK_IBM_CLIENT_SECRET=
# KNAPP_WEBHOOK_OAUTH_TENANT_ID=
# KNAPP_WEBHOOK_OAUTH_CLIENT_ID=
# KNAPP_WEBHOOK_OAUTH_CLIENT_SECRET=
# KNAPP_WEBHOOK_OAUTH_SCOPE=api://your-app-id/.default

# Same keys as knapp.mock.* in application.yml. KNAPP_MOCK_* overrides the names above.
# KNAPP_MOCK_BYPASS_AUTH=false
# KNAPP_MOCK_UI_AUTH_ENABLED=true
# KNAPP_MOCK_UI_USERNAME=knapp
# KNAPP_MOCK_REPLY_CALLBACK_ENABLED=true
# KNAPP_MOCK_REPLY_CALLBACK_PATH_PREFIX=oneapi/v1/_webhooks
# KNAPP_MOCK_INBOUND_AUTO_STOCK=false
# KNAPP_MOCK_STORAGE_ORDER_REPLY_ENABLED=false
# KNAPP_MOCK_IMPORT_DIR=data
# KNAPP_MOCK_IMPORT_INVENTORY_REPORT=
# KNAPP_MOCK_IMPORT_UNIQUIFY_ARTICLES=true
# KNAPP_MOCK_IMPORT_REPLACE_ALL=false
